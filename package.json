{
  "name": "qwq",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first AI companion server with CLI and Chinese voice frontends",
  "keywords": [
    "effect",
    "typescript",
    "nix",
    "voice-assistant",
    "sherpa-onnx",
    "server"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:gui": "rolldown -c rolldown.gui.config.ts && cp node_modules/@radix-ui/themes/styles.css packages/gui/dist/themes.css",
    "dev": "tsx packages/server/src/entries/qwq.ts serve",
    "start": "tsx scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:gui": "tsc --noEmit -p packages/gui/tsconfig.json",
    "check:ast": "tsx scripts/check-ast.ts",
    "check:shell": "tsx scripts/check-shell.ts",
    "lint": "eslint . && tsx scripts/check-ast.ts && tsx scripts/check-shell.ts",
    "check": "tsc --noEmit && tsc --noEmit -p packages/gui/tsconfig.json && eslint . && tsx scripts/check-ast.ts && tsx scripts/check-shell.ts && vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect-atom/atom": "^0.7.1",
    "@effect-atom/atom-react": "^0.7.0",
    "@effect/experimental": "^0.61.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@effect/rpc": "^0.76.2",
    "@qwq/cli": "workspace:*",
    "@qwq/server": "workspace:*",
    "@qwq/shared": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "effect": "^3.22.2",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-functional": "^9.0.2",
    "rolldown": "^1.2.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.1"
}
